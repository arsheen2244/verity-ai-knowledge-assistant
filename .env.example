# Copy this file to .env and fill in ONE provider's key.
# Leave both blank to run in fallback mode (retrieval works, answers show raw context).

LLM_PROVIDER=ollama             # "ollama" (free: local Ollama OR Groq/OpenRouter), "anthropic", "openai", or "none" (raw-context fallback)

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# FREE option. LLM_PROVIDER=ollama works with ANY OpenAI-compatible endpoint.
#
# (a) Local Ollama (private, offline; needs ~8 GB RAM, slow without a GPU):
#       run `ollama pull llama3.2:3b`, then
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2:3b
OLLAMA_API_KEY=ollama
#
# (b) Groq free tier (fast, no download; needs a key from console.groq.com):
#       OLLAMA_BASE_URL=https://api.groq.com/openai/v1
#       OLLAMA_API_KEY=your_groq_key
#       OLLAMA_MODEL=openai/gpt-oss-120b      # use an exact name from Groq's model list
#       OLLAMA_MAX_TOKENS=2000                # reasoning models need a bigger budget
OLLAMA_MAX_TOKENS=600

# Ragas judge (eval/run_eval.py only). "same" reuses LLM_PROVIDER.
# Other values: anthropic | openai | ollama | custom (any OpenAI-compatible endpoint)
JUDGE_PROVIDER=same
# JUDGE_BASE_URL=
# JUDGE_API_KEY=
# JUDGE_MODEL=

CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K=4

# Hybrid search (dense + BM25 keyword, merged by Reciprocal Rank Fusion)
HYBRID_ENABLED=true
HYBRID_CANDIDATE_K=20
RRF_K=60

# Cross-encoder reranking of the merged shortlist
RERANK_ENABLED=true
RERANK_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2

CHROMA_PERSIST_DIR=./chroma_db
COLLECTION_NAME=enterprise_docs
